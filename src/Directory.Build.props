<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      The version the product reports. It defaulted to 1.0.0, which over-claims for an early preview whose supported
      expression subset is deliberately narrow; keep the prerelease suffix until that surface stabilizes.

      This is scoped to src/ on purpose. Test targets and fixtures under tests/ keep the default identity, because
      several frozen physical-truth baselines record their exact assembly versions and must not move for a
      presentational change to the product's own version.
    -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <!-- The current product and evidence hosts are Windows-only; this also keeps the self-contained RID graph locked. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!--
      The current prerelease lane creates application ZIPs only for local validation; redistribution remains blocked
      pending third-party notice and bundled-license review. Keep every project under src/ non-packable until the
      repository defines package-specific compatibility, licensing, and validation contracts.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
