<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhoenixInspect.Desktop.App"
             Name="PhoenixInspect"
             xmlns:local="using:PhoenixInspect.Desktop"
             xmlns:dockTheme="using:Dock.Avalonia.Themes.Simple"
             xmlns:dockControls="using:Dock.Avalonia.Controls"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <!--
                The preview's light palette: a paper-like off-white dominates every surface, with muted olive for
                accents and exact evidence, soft khaki and sage for chips, highlights, and active chrome, quiet
                grays for borders and secondary text, and pale peach reserved for error conditions. The scheme is
                deliberately close to ILSpy's light chrome in structure (window / pane / editor / strip surfaces),
                kept low-saturation so the syntax-colored source reads as the strongest color on screen.
            -->
            <SolidColorBrush x:Key="Phoenix.WindowBackground" Color="#FAF9F4" />
            <SolidColorBrush x:Key="Phoenix.WindowForeground" Color="#3A3C33" />
            <SolidColorBrush x:Key="Phoenix.PaneBackground" Color="#FDFDFA" />
            <SolidColorBrush x:Key="Phoenix.EditorBackground" Color="#FFFFFD" />
            <SolidColorBrush x:Key="Phoenix.ChromeBorder" Color="#CCCABB" />
            <SolidColorBrush x:Key="Phoenix.SubtleBorder" Color="#E2E0D4" />
            <SolidColorBrush x:Key="Phoenix.SecondaryForeground" Color="#83857A" />
            <SolidColorBrush x:Key="Phoenix.AccentOlive" Color="#8A9B5C" />
            <SolidColorBrush x:Key="Phoenix.AccentOliveDeep" Color="#6D7C46" />
            <SolidColorBrush x:Key="Phoenix.Sage" Color="#B3C2A2" />
            <SolidColorBrush x:Key="Phoenix.SageLight" Color="#EDF2E4" />
            <SolidColorBrush x:Key="Phoenix.KhakiHighlight" Color="#F5EFC4" />
            <SolidColorBrush x:Key="Phoenix.KhakiChip" Color="#F4F2E5" />
            <SolidColorBrush x:Key="Phoenix.PeachBackground" Color="#FCF0E5" />
            <SolidColorBrush x:Key="Phoenix.PeachBorder" Color="#E2A981" />
            <SolidColorBrush x:Key="Phoenix.PeachForeground" Color="#AE5F38" />
            <SolidColorBrush x:Key="Phoenix.InputBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Phoenix.InputBorder" Color="#CCCABB" />
            <SolidColorBrush x:Key="Phoenix.TabStripBackground" Color="#F0EEE3" />
            <SolidColorBrush x:Key="Phoenix.TabItemSelectedBackground" Color="#FDFDFA" />
            <SolidColorBrush x:Key="Phoenix.TabItemActiveBackground" Color="#DFE6C9" />
            <SolidColorBrush x:Key="Phoenix.TabItemActiveForeground" Color="#3F4630" />
            <SolidColorBrush x:Key="Phoenix.ToolActiveHeaderBackground" Color="#E6EBDB" />
            <SolidColorBrush x:Key="Phoenix.SelectionBrush" Color="#8A9B5C" Opacity="0.20" />
            <SolidColorBrush x:Key="Phoenix.VerifiedBadgeBackground" Color="#EDF3DF" />
            <SolidColorBrush x:Key="Phoenix.VerifiedBadgeForeground" Color="#647F3E" />
            <FontFamily x:Key="Phoenix.MonoFont">Cascadia Mono,Consolas,Menlo,monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.v2.xaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
        <dockTheme:DockSimpleTheme CacheDocumentTabContent="True" />

        <!-- Window-level chrome. -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource Phoenix.WindowBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
        </Style>

        <!-- Reusable classes shared by the shell views. -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource Phoenix.KhakiChip}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Phoenix.SubtleBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{DynamicResource Phoenix.MonoFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.SecondaryForeground}" />
        </Style>
        <Style Selector="TextBlock.paneTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource Phoenix.TabItemActiveBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.TabItemActiveForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Phoenix.AccentOlive}" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Phoenix.ToolActiveHeaderBackground}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Phoenix.TabItemActiveForeground}" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Phoenix.PaneBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Phoenix.ChromeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MaxWidth" Value="560" />
        </Style>

        <!-- Menus. -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="{DynamicResource Phoenix.WindowBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
            <Setter Property="MinHeight" Value="26" />
        </Style>
        <Style Selector="MenuFlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource Phoenix.PaneBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
        </Style>

        <!-- Inputs. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource Phoenix.InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Phoenix.InputBorder}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Phoenix.SelectionBrush}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource Phoenix.PaneBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
        </Style>
        <Style Selector="TreeView">
            <Setter Property="Background" Value="{DynamicResource Phoenix.PaneBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
        </Style>

        <!-- Pane surfaces. Every grid gets Visual Studio's column separators and resizable columns by default. -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{DynamicResource Phoenix.PaneBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
            <Setter Property="GridLinesVisibility" Value="Vertical" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Phoenix.SubtleBorder}" />
            <Setter Property="CanUserResizeColumns" Value="True" />
        </Style>
        <Style Selector="DataGridRow:selected">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Dock chrome: tab strips and tool headers in the khaki family, olive for the active document. -->
        <Style Selector="dockControls|DocumentTabStrip, dockControls|ToolTabStrip">
            <Setter Property="Background" Value="{DynamicResource Phoenix.TabStripBackground}" />
        </Style>
        <Style Selector="dockControls|DocumentTabStripItem, dockControls|ToolTabStripItem">
            <Setter Property="Background" Value="{DynamicResource Phoenix.TabStripBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
        </Style>
        <Style Selector="dockControls|DocumentTabStripItem:selected:not(:active), dockControls|ToolTabStripItem:selected:not(:active)">
            <Setter Property="Background" Value="{DynamicResource Phoenix.TabItemSelectedBackground}" />
        </Style>
        <Style Selector="dockControls|DocumentTabStripItem:selected:active">
            <Setter Property="Background" Value="{DynamicResource Phoenix.TabItemActiveBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.TabItemActiveForeground}" />
        </Style>
        <Style Selector="dockControls|ToolTabStripItem:selected:active">
            <Setter Property="Background" Value="{DynamicResource Phoenix.TabItemSelectedBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
        </Style>
        <Style Selector="dockControls|ToolChromeControl:active /template/ Grid#PART_Grip">
            <Setter Property="Background" Value="{DynamicResource Phoenix.ToolActiveHeaderBackground}" />
        </Style>
        <Style Selector="dockControls|ToolChromeControl /template/ TextBlock#PART_Title">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="dockControls|ToolChromeControl:active /template/ TextBlock#PART_Title">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Phoenix.WindowForeground}" />
        </Style>
    </Application.Styles>
</Application>
