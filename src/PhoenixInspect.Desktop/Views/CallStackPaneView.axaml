<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhoenixInspect.Desktop.Views.CallStackPaneView"
             Background="{DynamicResource Phoenix.PaneBackground}">
    <!-- DataContext: CallStackTool -->
    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="max" Classes="secondary" FontSize="11" VerticalAlignment="Center" />
                    <TextBox Width="48" Padding="4,2" FontSize="11"
                             Text="{Binding Panel.FramesPerThread}"
                             ToolTip.Tip="Maximum managed frames retained for the displayed thread" />
                    <Button Content="Set as context"
                            FontSize="11"
                            Padding="8,3"
                            Command="{Binding Panel.UseAsContextCommand}"
                            ToolTip.Tip="Adopt the selected exact frame as the static-field name context" />
                    <Button Content="⟳"
                            FontSize="11"
                            Padding="8,3"
                            Command="{Binding Panel.RefreshCommand}"
                            ToolTip.Tip="Walk this thread's managed frames again with the current cap" />
                </StackPanel>
                <TextBlock Text="{Binding Panel.Caption}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <DataGrid x:Name="FramesGrid"
                  ItemsSource="{Binding Panel.Frames}"
                  SelectedItem="{Binding Panel.SelectedFrame, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  Margin="4,2"
                  DoubleTapped="OnDoubleTapped"
                  KeyDown="OnKeyDown">
            <DataGrid.Columns>
                <!-- Text columns pin the template columns' font size so every cell shares one row metric. -->
                <DataGridTextColumn Header="#" Binding="{Binding FrameOrdinal}" Width="Auto" FontSize="11" />
                <DataGridTemplateColumn Header="Name" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Classes="mono"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="4,0"
                                       Text="{Binding MethodDisplay}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding Detail}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Source" Width="1.4*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="4,0"
                                       Text="{Binding Location}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding LocationDetail}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Module" Binding="{Binding ModuleName}" Width="Auto" FontSize="11" />
                <DataGridTextColumn Header="IL" Binding="{Binding IlOffset}" Width="Auto" FontSize="11" />
                <DataGridTextColumn Header="IP" Binding="{Binding InstructionPointer}" Width="Auto" FontSize="11"
                                    FontFamily="Cascadia Mono,Consolas,monospace" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
