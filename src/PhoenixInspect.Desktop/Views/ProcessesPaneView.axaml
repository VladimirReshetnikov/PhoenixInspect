<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhoenixInspect.Desktop.Views.ProcessesPaneView"
             Background="{DynamicResource Phoenix.PaneBackground}">
    <!-- DataContext: ProcessesTool -->
    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        FontSize="11"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        Command="{Binding Panel.RefreshCommand}"
                        AutomationProperties.AutomationId="RefreshProcesses" />
                <Button DockPanel.Dock="Right"
                        Content="Attach"
                        FontSize="11"
                        Padding="8,2"
                        Command="{Binding Panel.AttachCommand}"
                        ToolTip.Tip="Attach to the selected process, suspending it for the session"
                        AutomationProperties.AutomationId="AttachSelectedProcess" />
                <TextBox DockPanel.Dock="Right"
                         Text="{Binding Panel.ProcessIdText, Mode=TwoWay}"
                         Width="90"
                         Margin="6,0,6,0"
                         FontSize="11"
                         PlaceholderText="or PID"
                         ToolTip.Tip="Attach to this process id directly; it takes precedence over the selection"
                         AutomationProperties.AutomationId="AttachPidBox" />
                <TextBox Text="{Binding Panel.Filter, Mode=TwoWay}"
                         PlaceholderText="Filter by process name or id"
                         FontSize="11"
                         AutomationProperties.AutomationId="ProcessFilterBox" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock Text="{Binding Panel.Summary}"
                       Classes="secondary"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </Border>
        <DataGrid ItemsSource="{Binding Panel.View}"
                  SelectedItem="{Binding Panel.Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  Margin="4,2"
                  AutomationProperties.AutomationId="ProcessesGrid"
                  DoubleTapped="OnDoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="180" FontSize="12" />
                <DataGridTextColumn Header="Id" Binding="{Binding ProcessId}" Width="Auto" FontSize="12"
                                    FontFamily="Cascadia Mono,Consolas,monospace" />
                <DataGridTextColumn Header="Detected as" Binding="{Binding Note}" Width="240" FontSize="12" />
                <DataGridTextColumn Header="Path" Binding="{Binding ExecutablePath}" Width="320" FontSize="12" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
