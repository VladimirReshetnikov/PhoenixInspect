<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:PhoenixInspect.Desktop.Converters"
             x:Class="PhoenixInspect.Desktop.Views.WatchPaneView"
             Background="{DynamicResource Phoenix.PaneBackground}">
    <!-- DataContext: WatchTool -->
    <DockPanel>
        <!-- The completion drop-down: one popup shared by every expression editor, placed under the active one.
             Items come from ExpressionCompletionService through the pane view model; the view only renders. -->
        <Popup x:Name="CompletionPopup"
               DockPanel.Dock="Top"
               Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="False"
               ShouldUseOverlayLayer="True">
            <Border Background="{DynamicResource Phoenix.PaneBackground}"
                    BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                    BorderThickness="1"
                    MinWidth="260"
                    MaxHeight="220">
                <ListBox x:Name="CompletionList"
                         AutomationProperties.AutomationId="WatchCompletionList"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Width="14" Height="14"
                                        CornerRadius="3"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding Kind, Converter={x:Static conv:CompletionKindToBrushConverter.Instance}}">
                                    <TextBlock Text="{Binding Kind, Converter={x:Static conv:CompletionKindToGlyphConverter.Instance}}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Detail}"
                                           Classes="secondary"
                                           FontSize="10"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Text}"
                                           FontSize="12"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
        <!-- Signature help renders the modeled overloads while an argument list is typed; it yields to the
             completion drop-down and reappears between arguments. -->
        <Popup x:Name="SignaturePopup"
               DockPanel.Dock="Top"
               Placement="BottomEdgeAlignedLeft"
               IsLightDismissEnabled="False"
               ShouldUseOverlayLayer="True">
            <Border Background="{DynamicResource Phoenix.PaneBackground}"
                    BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                    BorderThickness="1"
                    Padding="8,4">
                <StackPanel x:Name="SignatureStack" Spacing="2" />
            </Border>
        </Popup>
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        FontSize="11"
                        Padding="8,2"
                        Command="{Binding Panel.RefreshCommand}"
                        AutomationProperties.AutomationId="RefreshWatches" />
                <TextBlock Classes="secondary"
                           Text="{Binding Panel.Caption}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock Text="{Binding Panel.Summary}"
                       Classes="secondary"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </Border>
        <DataGrid ItemsSource="{Binding Panel.Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  Margin="4,2">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="9" Height="9"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding HasReport}"
                                     Fill="{Binding Severity, Converter={x:Static conv:SeverityToBrushConverter.Instance}}"
                                     ToolTip.Tip="{Binding Status}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- The expression cell is a live editor, not an edit-mode cell: every watch stays directly
                     editable in place, and the trailing placeholder row adds a new watch on commit. Child rows
                     of an expanded compound value render read-only with a tree indent, like Visual Studio. -->
                <DataGridTemplateColumn Header="Name" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel Margin="{Binding NameIndent}">
                                <!-- The fixed-width host keeps name text aligned whether or not a chevron shows. -->
                                <Border DockPanel.Dock="Left" Width="18">
                                    <Button Content="{Binding ExpanderGlyph}"
                                            FontSize="10"
                                            Padding="2,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasChildren}"
                                            AutomationProperties.AutomationId="ExpandWatch"
                                            Click="OnToggleExpand" />
                                </Border>
                                <TextBox Text="{Binding Expression, Mode=TwoWay}"
                                         PlaceholderText="Add item to watch"
                                         FontSize="12"
                                         FontFamily="Cascadia Mono,Consolas,monospace"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="4,2"
                                         VerticalContentAlignment="Center"
                                         IsVisible="{Binding IsEditable}"
                                         AutomationProperties.AutomationId="WatchExpressionBox"
                                         KeyDown="OnExpressionKeyDown"
                                         TextChanged="OnExpressionTextChanged"
                                         LostFocus="OnExpressionLostFocus" />
                                <TextBlock Text="{Binding NameText}"
                                           FontSize="12"
                                           FontFamily="Cascadia Mono,Consolas,monospace"
                                           Padding="4,2"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !IsEditable}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="330" FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace" />
                <DataGridTextColumn Header="Kind" Binding="{Binding ValueKind}" Width="Auto" FontSize="12" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" FontSize="12" />
                <DataGridTemplateColumn Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕"
                                    FontSize="10"
                                    Padding="5,1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding ShowsDelete}"
                                    ToolTip.Tip="Delete watch"
                                    AutomationProperties.AutomationId="DeleteWatch"
                                    Click="OnDeleteClick" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
