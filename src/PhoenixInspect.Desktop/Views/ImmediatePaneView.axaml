<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="PhoenixInspect.Desktop.Views.ImmediatePaneView"
             Background="{DynamicResource Phoenix.EditorBackground}">
    <!-- DataContext: ImmediateTool -->
    <DockPanel>
        <!-- The completion drop-down shares its computation and state with every other expression editor. -->
        <Popup x:Name="CompletionPopup"
               DockPanel.Dock="Top"
               Placement="TopEdgeAlignedLeft"
               IsLightDismissEnabled="False"
               ShouldUseOverlayLayer="True">
            <Border Background="{DynamicResource Phoenix.PaneBackground}"
                    BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                    BorderThickness="1"
                    MinWidth="260"
                    MaxHeight="220">
                <ListBox x:Name="CompletionList"
                         AutomationProperties.AutomationId="ImmediateCompletionList"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding Detail}"
                                           Classes="secondary"
                                           FontSize="10"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Text}"
                                           FontSize="12"
                                           FontFamily="Cascadia Mono,Consolas,monospace" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Phoenix.PaneBackground}"
                BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Clear"
                        FontSize="11"
                        Padding="8,2"
                        Command="{Binding Panel.ClearCommand}"
                        AutomationProperties.AutomationId="ClearImmediate" />
                <TextBlock Classes="secondary"
                           Text="{Binding Panel.Caption}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Phoenix.PaneBackground}"
                BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <TextBlock Text="{Binding Panel.Summary}"
                       Classes="secondary"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </Border>
        <!-- One continuous console surface, like Visual Studio's Immediate window: the transcript and the live
             prompt line share the same background and scroll together, so the input is simply the last line.
             The prompt glyph is a quiet button, keeping the flow drivable without keyboard injection. -->
        <ScrollViewer x:Name="TranscriptScroll"
                      Background="{DynamicResource Phoenix.EditorBackground}"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PointerReleased="OnSurfacePointerReleased">
            <StackPanel x:Name="ConsoleStack" Orientation="Vertical" Margin="2,2,2,0">
                <ae:TextEditor x:Name="TranscriptEditor"
                               IsReadOnly="True"
                               ShowLineNumbers="False"
                               FontFamily="{DynamicResource Phoenix.MonoFont}"
                               FontSize="12"
                               Background="Transparent"
                               IsVisible="False"
                               HorizontalScrollBarVisibility="Disabled"
                               VerticalScrollBarVisibility="Disabled" />
                <DockPanel>
                    <Button DockPanel.Dock="Left"
                            Content=">"
                            FontSize="12"
                            FontFamily="Cascadia Mono,Consolas,monospace"
                            Padding="2,0,4,0"
                            Margin="2,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Evaluate (Enter)"
                            AutomationProperties.AutomationId="ImmediateSubmit"
                            Click="OnSubmitClick" />
                    <TextBox x:Name="InputBox"
                             Text="{Binding Panel.InputText, Mode=TwoWay}"
                             PlaceholderText="Evaluate an expression…"
                             FontSize="12"
                             FontFamily="Cascadia Mono,Consolas,monospace"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="2,1"
                             MinHeight="0"
                             VerticalContentAlignment="Center"
                             AutomationProperties.AutomationId="ImmediateInputBox"
                             KeyDown="OnInputKeyDown"
                             TextChanged="OnInputTextChanged"
                             LostFocus="OnInputLostFocus" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
