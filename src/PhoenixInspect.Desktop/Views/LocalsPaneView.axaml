<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhoenixInspect.Desktop.Views.LocalsPaneView"
             Background="{DynamicResource Phoenix.PaneBackground}">
    <!-- DataContext: LocalsTool -->
    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <TextBlock Classes="mono"
                       Text="{Binding Panel.Caption}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </Border>
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource Phoenix.SubtleBorder}"
                BorderThickness="0,1,0,0"
                Padding="8,4">
            <TextBlock Text="{Binding Panel.Summary}"
                       Classes="secondary"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </Border>
        <DataGrid ItemsSource="{Binding Panel.Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  Margin="4,2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"
                                    FontFamily="Cascadia Mono,Consolas,monospace" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="220"
                                    FontFamily="Cascadia Mono,Consolas,monospace" />
                <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="Auto" />
                <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="Auto" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Note}" Width="280" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
