<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:PhoenixInspect.Wpf.Converters">

    <!-- Converters are declared here so styles in this dictionary can resolve them at parse time. -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:EmptyToVisibilityConverter x:Key="EmptyToVisibility" />
    <conv:SeverityToBrushConverter x:Key="SeverityToBrush" />
    <conv:SeverityToGlyphConverter x:Key="SeverityToGlyph" />

    <!--
        A single dark palette shared by every panel. Semantic accents are separated from the brand accent so an
        evaluation outcome never borrows the colour of an interactive affordance.
    -->
    <Color x:Key="Color.Surface.Base">#FF10121A</Color>
    <Color x:Key="Color.Surface.Panel">#FF171A23</Color>
    <Color x:Key="Color.Surface.Raised">#FF1F2430</Color>
    <Color x:Key="Color.Surface.Input">#FF0B0D13</Color>
    <Color x:Key="Color.Border.Subtle">#FF272C38</Color>
    <Color x:Key="Color.Border.Strong">#FF3A4252</Color>
    <Color x:Key="Color.Text.Primary">#FFE7EAF2</Color>
    <Color x:Key="Color.Text.Secondary">#FF98A2B6</Color>
    <Color x:Key="Color.Text.Muted">#FF6C768C</Color>
    <Color x:Key="Color.Brand">#FFFF7A45</Color>
    <Color x:Key="Color.Brand.Deep">#FFD8552A</Color>
    <Color x:Key="Color.Info">#FF4C8DFF</Color>

    <SolidColorBrush x:Key="Surface.Base" Color="{StaticResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Surface.Panel" Color="{StaticResource Color.Surface.Panel}" />
    <SolidColorBrush x:Key="Surface.Raised" Color="{StaticResource Color.Surface.Raised}" />
    <SolidColorBrush x:Key="Surface.Input" Color="{StaticResource Color.Surface.Input}" />
    <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brand" Color="{StaticResource Color.Brand}" />
    <SolidColorBrush x:Key="Brand.Deep" Color="{StaticResource Color.Brand.Deep}" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource Color.Info}" />

    <SolidColorBrush x:Key="Accent.Exact" Color="#FF3FBF7F" />
    <SolidColorBrush x:Key="Accent.Absent" Color="#FF4C8DFF" />
    <SolidColorBrush x:Key="Accent.Partial" Color="#FFE8B23A" />
    <SolidColorBrush x:Key="Accent.Stopped" Color="#FFE4574C" />
    <SolidColorBrush x:Key="Accent.Rejected" Color="#FFB45AD8" />

    <SolidColorBrush x:Key="Surface.Hover" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#2AFF7A45" />

    <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <CornerRadius x:Key="Corner.Panel">8</CornerRadius>
    <CornerRadius x:Key="Corner.Control">6</CornerRadius>

    <!-- Typography -->
    <Style TargetType="TextBlock" x:Key="Text.Body">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- Every unstyled TextBlock inherits the dark-surface defaults. -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}" />

    <Style TargetType="TextBlock" x:Key="Text.Title" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Text.Section" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Text.Caption" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Text.Label" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Text.Mono" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button" x:Key="Button.Primary">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FF16100C" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{StaticResource Brand}"
                            CornerRadius="{StaticResource Corner.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FFFF8F60" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brand.Deep}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Raised}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Button.Ghost">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="{StaticResource Border.Strong}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Corner.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="Button.Chip" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
    </Style>

    <!-- Text input -->
    <Style TargetType="TextBox" x:Key="Input.Text">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="CaretBrush" Value="{StaticResource Brand}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Brand}" />
        <Setter Property="Padding" Value="9,7" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource Surface.Input}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Corner.Control}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brand}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox" x:Key="Input.Expression" BasedOn="{StaticResource Input.Text}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="11,10" />
        <Setter Property="AcceptsReturn" Value="False" />
    </Style>

    <!-- Selection controls -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="15" Height="15"
                                Background="{StaticResource Surface.Input}"
                                BorderBrush="{StaticResource Border.Strong}"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="Tick"
                                       Text="✓"
                                       FontSize="10"
                                       Foreground="#FF16100C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource Brand}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brand}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Corner.Control}"
                            Padding="12,8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Selected}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brand}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scroll bars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="9" />
        <Setter Property="MinWidth" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#40FFFFFF"
                                                    CornerRadius="4"
                                                    Margin="2,0" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="9" />
                <Setter Property="MinHeight" Value="9" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#40FFFFFF"
                                                            CornerRadius="4"
                                                            Margin="0,2" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Tool-window chrome. Every docked panel is a Tool.Container with one Tool.HeaderBar at the top, so the shell
        reads as one debugger-style workspace rather than a set of unrelated cards.
    -->
    <Style TargetType="Border" x:Key="Tool.Container">
        <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Corner.Panel}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="Border" x:Key="Tool.HeaderBar">
        <Setter Property="Background" Value="{StaticResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Text.ToolTitle" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Invisible-until-hovered splitters between docked tool windows. -->
    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#33FF7A45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Compact segmented toggle used for the evaluation entry-point switch. -->
    <Style TargetType="RadioButton" x:Key="Toggle.Segment">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="10,4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Selected}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small header-bar toggle that reveals an options area. -->
    <Style TargetType="ToggleButton" x:Key="Toggle.Chip">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="{StaticResource Border.Strong}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Corner.Control}"
                            Padding="9,3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Selected}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brand}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain list styling used by result and history lists -->
    <Style TargetType="ListBox" x:Key="List.Plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style TargetType="ListBoxItem" x:Key="List.Item">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{StaticResource Corner.Control}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="10,8" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Raised}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Property lists: grouped label/value pairs -->
    <Style TargetType="GroupItem" x:Key="Property.Group">
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <DataTemplate x:Key="Property.Row">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}"
                       Style="{StaticResource Text.Caption}"
                       Foreground="{StaticResource Text.Muted}"
                       Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Mono}" />
                <TextBlock Text="{Binding Detail}"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{StaticResource Text.Muted}"
                           FontSize="11"
                           Margin="0,2,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource EmptyToVisibility}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!--
        GroupStyle is a read-only collection, so it cannot be assigned by a Style setter. The shared instance is
        published as a resource and attached by each property list with a StaticResource collection element.
    -->
    <GroupStyle x:Key="Property.GroupStyle" ContainerStyle="{StaticResource Property.Group}">
        <GroupStyle.HeaderTemplate>
            <DataTemplate>
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource Text.Section}"
                           Margin="0,10,0,6" />
            </DataTemplate>
        </GroupStyle.HeaderTemplate>
    </GroupStyle>

    <Style TargetType="ItemsControl" x:Key="Property.List">
        <Setter Property="ItemTemplate" Value="{StaticResource Property.Row}" />
    </Style>

    <!-- Data grid -->
    <Style TargetType="DataGrid" x:Key="Grid.Data">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#0AFFFFFF" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="ColumnHeaderHeight" Value="30" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface.Selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tree view -->
    <Style TargetType="TreeView" x:Key="Tree.Stacks">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <!-- Expansion is owned by the node so the panel can pre-expand a thread and load its frames on demand. -->
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleButton x:Name="Expander"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Focusable="False"
                                      VerticalAlignment="Top"
                                      Margin="0,9,0,0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Width="18" Height="18">
                                        <TextBlock x:Name="Glyph"
                                                   Text="▸"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brand}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Glyph" Property="Text" Value="▾" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="Chrome"
                                Grid.Column="1"
                                Background="Transparent"
                                CornerRadius="{StaticResource Corner.Control}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" Margin="8,6" />
                        </Border>
                        <ItemsPresenter x:Name="Items"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="10,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Evidence tabs -->
    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Text.Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="{StaticResource Corner.Control}"
                                Margin="0,0,4,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" Margin="13,7" />
                        </Border>
                        <Border x:Name="Underline"
                                Height="2"
                                Margin="4,0"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource Brand}"
                                CornerRadius="1"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface.Hover}" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="4,4,4,0" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chromeless tab control used to switch section panels -->
    <Style TargetType="TabControl" x:Key="Tabs.Chromeless">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card container -->
    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource Surface.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Corner.Panel}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="Border" x:Key="Card.Inset" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="#33000000" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Border.Subtle}" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

</ResourceDictionary>
