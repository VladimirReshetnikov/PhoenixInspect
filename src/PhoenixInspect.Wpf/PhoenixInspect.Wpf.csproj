<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The PhoenixInspect desktop shell. It presents an opened dump as an inspectable session and adds no analysis of
    its own: every fact it renders comes from an existing public contract, projected by PhoenixInspect.Inspection.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhoenixInspect.Wpf</RootNamespace>
    <AssemblyName>PhoenixInspect</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhoenixInspect.Inspection\PhoenixInspect.Inspection.csproj" />
  </ItemGroup>

</Project>
