<Window x:Class="PhoenixInspect.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhoenixInspect.Wpf.ViewModels"
        xmlns:models="clr-namespace:PhoenixInspect.Inspection;assembly=PhoenixInspect.Inspection"
        Title="PhoenixInspect — post-mortem inspection"
        Background="{StaticResource Surface.Base}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        MinWidth="1180"
        MinHeight="720"
        Width="1380"
        Height="860"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <Window.Resources>

        <!-- Call-stack tree -->
        <HierarchicalDataTemplate x:Key="ThreadTemplate"
                                  DataType="{x:Type models:CallStackThreadNode}"
                                  ItemsSource="{Binding Frames}">
            <StackPanel>
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" FontSize="11" />
            </StackPanel>
            <HierarchicalDataTemplate.ItemTemplate>
                <DataTemplate DataType="{x:Type models:CallStackFrameNode}">
                    <StackPanel>
                        <TextBlock Text="{Binding Header}" Style="{StaticResource Text.Mono}" />
                        <TextBlock Text="{Binding Detail}"
                                   Style="{StaticResource Text.Caption}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}" />
                    </StackPanel>
                </DataTemplate>
            </HierarchicalDataTemplate.ItemTemplate>
        </HierarchicalDataTemplate>

        <!-- Expression template chip -->
        <DataTemplate x:Key="SampleTemplate" DataType="{x:Type vm:ExpressionSample}">
            <Button Style="{StaticResource Button.Chip}"
                    Click="OnSampleClick"
                    Margin="0,0,6,6"
                    ToolTip="{Binding Text}"
                    Content="{Binding Label}" />
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Toolbar ============================ -->
        <Border Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            CornerRadius="8"
                            Background="{StaticResource Brand}"
                            Margin="0,0,10,0">
                        <TextBlock Text="◆"
                                   FontSize="13"
                                   Foreground="#FF16100C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PhoenixInspect"
                               Style="{StaticResource Text.Title}"
                               FontSize="15"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Open snapshot chips -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="18,0"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsDumpOpen, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card.Inset}" Padding="10,5" Margin="0,0,8,0" CornerRadius="6">
                        <TextBlock Text="{Binding DumpFileName}"
                                   Style="{StaticResource Text.Mono}"
                                   ToolTip="{Binding DumpDirectory}" />
                    </Border>
                    <Border Style="{StaticResource Card.Inset}" Padding="10,5" Margin="0,0,8,0" CornerRadius="6"
                            ToolTip="SHA-256 content identity of the complete dump file">
                        <TextBlock Text="{Binding SnapshotDigest}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Text.Secondary}" />
                    </Border>
                    <Border Style="{StaticResource Card.Inset}" Padding="10,5" CornerRadius="6">
                        <TextBlock Text="{Binding TargetSummary}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Text.Secondary}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Close dump"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding CloseDumpCommand}"
                            Margin="0,0,10,0"
                            Visibility="{Binding IsDumpOpen, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Open dump…"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding OpenDumpCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================= Error banner ========================= -->
        <Border Grid.Row="1"
                Background="#33E4574C"
                BorderBrush="{StaticResource Accent.Stopped}"
                BorderThickness="0,0,0,1"
                Padding="14,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="！"
                           Foreground="{StaticResource Accent.Stopped}"
                           FontWeight="Bold"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorMessage}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="Dismiss"
                        Style="{StaticResource Button.Chip}"
                        Click="OnDismissErrorClick" />
            </Grid>
        </Border>

        <!-- ====================== Docked workspace ======================= -->
        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="390" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ~~~~~~~~~~~~~~~~~~ Left dock ~~~~~~~~~~~~~~~~~~ -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="300" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- Call Stack tool window -->
                <Border Style="{StaticResource Tool.Container}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource Tool.HeaderBar}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CALL STACK" Style="{StaticResource Text.ToolTitle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Set as context"
                                            Style="{StaticResource Button.Chip}"
                                            Command="{Binding CallStacks.UseAsContextCommand}"
                                            ToolTip="Adopt the selected exact frame as the static-field name context"
                                            Margin="0,0,6,0" />
                                    <Button Content="⟳"
                                            Style="{StaticResource Button.Chip}"
                                            Command="{Binding CallStacks.ProbeCommand}"
                                            ToolTip="Probe thread ordinals again with the caps below" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border DockPanel.Dock="Top"
                                Background="{StaticResource Surface.Panel}"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="0,0,0,1"
                                Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="probe" Style="{StaticResource Text.Caption}" FontSize="11"
                                           Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Style="{StaticResource Input.Text}" Width="52" Padding="6,2" FontSize="11"
                                         Text="{Binding CallStacks.ThreadOrdinalsToProbe}"
                                         ToolTip="Zero-based thread ordinals to probe" />
                                <TextBlock Text="ordinals ×" Style="{StaticResource Text.Caption}" FontSize="11"
                                           Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="6,0" />
                                <TextBox Style="{StaticResource Input.Text}" Width="52" Padding="6,2" FontSize="11"
                                         Text="{Binding CallStacks.FramesPerThread}"
                                         ToolTip="Maximum managed frames retained per thread" />
                                <TextBlock Text="frames" Style="{StaticResource Text.Caption}" FontSize="11"
                                           Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom"
                                BorderBrush="{StaticResource Border.Subtle}"
                                BorderThickness="0,1,0,0"
                                Padding="12,6">
                            <TextBlock Text="{Binding CallStacks.Summary}"
                                       Style="{StaticResource Text.Caption}"
                                       FontSize="11"
                                       Foreground="{StaticResource Text.Muted}"
                                       ToolTip="{Binding CallStacks.Note}" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="6">
                            <TreeView x:Name="StacksTree"
                                      Style="{StaticResource Tree.Stacks}"
                                      ItemsSource="{Binding CallStacks.Threads}"
                                      ItemTemplate="{StaticResource ThreadTemplate}"
                                      SelectedItemChanged="OnStackSelectionChanged"
                                      MouseDoubleClick="OnStackDoubleClick"
                                      TreeViewItem.Expanded="OnThreadExpanded" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

                <!-- Modules / Heap objects tool tabs -->
                <Border Grid.Row="2" Style="{StaticResource Tool.Container}">
                    <TabControl Padding="0">
                        <TabItem Header="MODULES">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="10,8,10,4">
                                    <TextBox Style="{StaticResource Input.Text}"
                                             Padding="8,4"
                                             FontSize="12"
                                             Text="{Binding Modules.Filter, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Filter by module name or target path hint" />
                                </Border>
                                <Expander DockPanel.Dock="Bottom"
                                          Header="Content identity"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="11"
                                          Margin="10,2,10,6"
                                          IsExpanded="False"
                                          Visibility="{Binding Modules.HasSelection, Converter={StaticResource BoolToVisibility}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                        <ItemsControl ItemsSource="{Binding Modules.GroupedDetails}"
                                                      Style="{StaticResource Property.List}">
                                            <ItemsControl.GroupStyle>
                                                <StaticResource ResourceKey="Property.GroupStyle" />
                                            </ItemsControl.GroupStyle>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>
                                <DataGrid Style="{StaticResource Grid.Data}"
                                          Margin="4,0"
                                          RowHeight="26"
                                          ItemsSource="{Binding Modules.View}"
                                          SelectedItem="{Binding Modules.Selected, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MODULE" Binding="{Binding Name}" Width="*" MinWidth="140" />
                                        <DataGridTextColumn Header="SIZE" Binding="{Binding MetadataLength}" Width="76" />
                                        <DataGridTextColumn Header="LAYOUT" Binding="{Binding Layout}" Width="70" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="HEAP SEARCH">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="10,8,10,4">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Style="{StaticResource Input.Text}"
                                                     Padding="8,4"
                                                     FontSize="12"
                                                     FontFamily="{StaticResource Font.Mono}"
                                                     Text="{Binding HeapObjects.TypeName, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="OnObjectSearchKeyDown"
                                                     ToolTip="Exact case-sensitive runtime type name" />
                                            <Button Grid.Column="1"
                                                    Content="Search"
                                                    Style="{StaticResource Button.Chip}"
                                                    Command="{Binding HeapObjects.SearchCommand}"
                                                    Margin="6,0,0,0" />
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBox Style="{StaticResource Input.Text}" Width="52" Padding="6,2" FontSize="11"
                                                     Text="{Binding HeapObjects.MaximumMatches}"
                                                     ToolTip="Retained-match cap" />
                                            <TextBlock Text="matches ·" Style="{StaticResource Text.Caption}" FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="6,0" />
                                            <TextBox Style="{StaticResource Input.Text}" Width="72" Padding="6,2" FontSize="11"
                                                     Text="{Binding HeapObjects.MaximumHandlesScanned}"
                                                     ToolTip="Handle-inspection cap" />
                                            <TextBlock Text="handles" Style="{StaticResource Text.Caption}" FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            <Button Content="Use as root"
                                                    Style="{StaticResource Button.Chip}"
                                                    Command="{Binding HeapObjects.UseAsRootCommand}"
                                                    ToolTip="Adopt the selected match as the root-relative expression root"
                                                    Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Expander DockPanel.Dock="Bottom"
                                          Header="Traversal evidence"
                                          Foreground="{StaticResource Text.Secondary}"
                                          FontSize="11"
                                          Margin="10,2,10,6"
                                          IsExpanded="False"
                                          Visibility="{Binding HeapObjects.SearchFacts.Count, Converter={StaticResource EmptyToVisibility}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                        <ItemsControl ItemsSource="{Binding HeapObjects.GroupedSearchFacts}"
                                                      Style="{StaticResource Property.List}">
                                            <ItemsControl.GroupStyle>
                                                <StaticResource ResourceKey="Property.GroupStyle" />
                                            </ItemsControl.GroupStyle>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>
                                <Grid>
                                    <TextBlock Text="{Binding HeapObjects.Summary}"
                                               Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Text.Muted}"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               MaxWidth="260"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Panel.ZIndex="1"
                                               Visibility="{Binding HeapObjects.Matches.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=invert}" />
                                    <DataGrid Style="{StaticResource Grid.Data}"
                                              Margin="4,0"
                                              RowHeight="26"
                                              ItemsSource="{Binding HeapObjects.Matches}"
                                              SelectedItem="{Binding HeapObjects.Selected, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="140"
                                                                FontFamily="{StaticResource Font.Mono}" />
                                            <DataGridTextColumn Header="RUNTIME TYPE" Binding="{Binding TypeName}" Width="*" MinWidth="120" />
                                            <DataGridTextColumn Header="HANDLE" Binding="{Binding RootKind}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- ~~~~~~~~~~~~~~~~~~ Center: evaluation console ~~~~~~~~~~~~~~~~~~ -->
            <Border Grid.Column="2" Style="{StaticResource Tool.Container}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Tool.HeaderBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="EVALUATE — C# EXPRESSION" Style="{StaticResource Text.ToolTitle}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Background="{StaticResource Surface.Input}"
                                        CornerRadius="6"
                                        Padding="2"
                                        Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Toggle.Segment}"
                                                     GroupName="PathSegment"
                                                     Content="Static field"
                                                     ToolTip="Namespace-qualified static field, bound from module metadata"
                                                     IsChecked="{Binding Evaluate.IsStaticFieldPath, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource Toggle.Segment}"
                                                     GroupName="PathSegment"
                                                     Content="Root-relative"
                                                     ToolTip="Member expression over one exact heap object"
                                                     IsChecked="{Binding Evaluate.IsRootRelativePath, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                                <ToggleButton x:Name="OptionsToggle"
                                              Style="{StaticResource Toggle.Chip}"
                                              Content="Options"
                                              Margin="0,0,6,0" />
                                <Button Content="Clear"
                                        Style="{StaticResource Button.Chip}"
                                        ToolTip="Clear the evaluation history"
                                        Command="{Binding Evaluate.ClearHistoryCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Expression input -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource Surface.Panel}"
                            BorderBrush="{StaticResource Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="❯"
                                           FontFamily="{StaticResource Font.Mono}"
                                           FontSize="15"
                                           Foreground="{StaticResource Brand}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox x:Name="ExpressionBox"
                                         Grid.Column="1"
                                         Style="{StaticResource Input.Expression}"
                                         Text="{Binding Evaluate.Expression, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnExpressionKeyDown" />
                                <Button Grid.Column="2"
                                        Content="Evaluate"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding Evaluate.EvaluateCommand}"
                                        Margin="8,0,0,0"
                                        Padding="18,7" />
                            </Grid>
                            <TextBlock Text="{Binding Evaluate.ReadinessMessage}"
                                       Style="{StaticResource Text.Caption}"
                                       FontSize="11"
                                       Foreground="{StaticResource Text.Muted}"
                                       Margin="24,6,0,0" />
                            <ItemsControl ItemsSource="{Binding Evaluate.Samples}"
                                          ItemTemplate="{StaticResource SampleTemplate}"
                                          Margin="24,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Collapsible options -->
                            <StackPanel Margin="24,4,0,0"
                                        Visibility="{Binding IsChecked, ElementName=OptionsToggle, Converter={StaticResource BoolToVisibility}}">
                                <Border Style="{StaticResource Card.Inset}"
                                        Visibility="{Binding Evaluate.IsStaticFieldPath, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="NAME CONTEXT" Style="{StaticResource Text.Label}" />
                                            <TextBlock Text="{Binding Evaluate.ContextDescription}"
                                                       Style="{StaticResource Text.Caption}" />
                                            <Button Content="Drop adopted frame"
                                                    Style="{StaticResource Button.Chip}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,8,0,0"
                                                    Command="{Binding Evaluate.ClearContextCommand}"
                                                    Visibility="{Binding Evaluate.HasContextFrame, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PORTABLE-PDB CANDIDATES (ONE PATH PER LINE)" Style="{StaticResource Text.Label}" />
                                            <TextBox Style="{StaticResource Input.Text}"
                                                     FontFamily="{StaticResource Font.Mono}"
                                                     FontSize="11"
                                                     Height="62"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding Evaluate.PortablePdbCandidates, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card.Inset}"
                                        Visibility="{Binding Evaluate.IsRootRelativePath, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="ROOT IDENTIFIER" Style="{StaticResource Text.Label}" />
                                                <TextBox Style="{StaticResource Input.Text}"
                                                         FontFamily="{StaticResource Font.Mono}"
                                                         Width="150"
                                                         Text="{Binding Evaluate.RootIdentifier, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ADOPTED ROOT" Style="{StaticResource Text.Label}" />
                                                <TextBlock Text="{Binding Evaluate.RootDescription}"
                                                           Style="{StaticResource Text.Caption}"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="11" />
                                                <Button Content="Drop adopted root"
                                                        Style="{StaticResource Button.Chip}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"
                                                        Command="{Binding Evaluate.ClearRootCommand}"
                                                        Visibility="{Binding Evaluate.HasRootObject, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                        <Separator />
                                        <WrapPanel>
                                            <CheckBox Content="Admit two-hop member chains"
                                                      Margin="0,0,22,8"
                                                      IsChecked="{Binding Evaluate.AdmitMemberChain, Mode=TwoWay}" />
                                            <CheckBox Content="Replace admitted helpers with pure models"
                                                      Margin="0,0,22,8"
                                                      IsChecked="{Binding Evaluate.UseModeledMethods, Mode=TwoWay}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                                <TextBlock Text="Instruction budget"
                                                           Style="{StaticResource Text.Caption}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBox Style="{StaticResource Input.Text}"
                                                         Width="100"
                                                         Padding="8,4"
                                                         Text="{Binding Evaluate.InstructionLimit}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                                <TextBlock Text="Call depth"
                                                           Style="{StaticResource Text.Caption}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBox Style="{StaticResource Input.Text}"
                                                         Width="70"
                                                         Padding="8,4"
                                                         Text="{Binding Evaluate.LogicalDepthLimit}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Traversal units"
                                                           Style="{StaticResource Text.Caption}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBox Style="{StaticResource Input.Text}"
                                                         Width="90"
                                                         Padding="8,4"
                                                         Text="{Binding Evaluate.TraversalLimit}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Evaluate.LimitsCaption}"
                                                   Style="{StaticResource Text.Caption}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Watch-style history grid -->
                    <Grid>
                        <TextBlock Text="Evaluated expressions appear here with their value, kind, and status. Select a row to inspect the complete evidence."
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Text.Muted}"
                                   TextAlignment="Center"
                                   MaxWidth="420"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Panel.ZIndex="1"
                                   Visibility="{Binding Evaluate.History.Count, Converter={StaticResource EmptyToVisibility}, ConverterParameter=invert}" />
                        <DataGrid Style="{StaticResource Grid.Data}"
                                  Margin="4"
                                  ItemsSource="{Binding Evaluate.History}"
                                  SelectedItem="{Binding Evaluate.Report, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="26">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:EvaluationReport}">
                                            <Border Width="8" Height="8"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                    ToolTip="{Binding Status}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="EXPRESSION" Binding="{Binding Expression}" Width="2*" MinWidth="180"
                                                    FontFamily="{StaticResource Font.Mono}" />
                                <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="2*" MinWidth="140"
                                                    FontFamily="{StaticResource Font.Mono}" />
                                <DataGridTextColumn Header="KIND" Binding="{Binding ValueKind}" Width="130" />
                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" />
                                <DataGridTextColumn Header="MS" Binding="{Binding Duration.TotalMilliseconds, StringFormat={}{0:N1}}" Width="64" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

            <!-- ~~~~~~~~~~~~~~~~~~ Right dock: evidence ~~~~~~~~~~~~~~~~~~ -->
            <Border Grid.Column="4" Style="{StaticResource Tool.Container}">
                <TabControl Padding="0">
                    <TabItem Header="RESULT">
                        <Grid>
                            <TextBlock Text="No expression is selected. Evaluate one, or select a row in the history."
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Text.Muted}"
                                       TextAlignment="Center"
                                       MaxWidth="280"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Evaluate.HasReport, Converter={StaticResource InverseBoolToVisibility}}" />

                            <!-- The DataContext assignment applies to this element's own bindings, so the visibility
                                 path is relative to the evaluation panel, not the shell. -->
                            <DockPanel DataContext="{Binding Evaluate}"
                                       Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                                <!-- Outcome banner -->
                                <Border DockPanel.Dock="Top"
                                        Background="{StaticResource Surface.Raised}"
                                        Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32"
                                                CornerRadius="16"
                                                Margin="0,0,12,0"
                                                Background="{Binding Report.Severity, Converter={StaticResource SeverityToBrush}}">
                                            <TextBlock Text="{Binding Report.Severity, Converter={StaticResource SeverityToGlyph}}"
                                                       FontSize="14"
                                                       Foreground="#FF10121A"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Title}" FontSize="14">
                                                <Run Text="{Binding Report.Status, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Report.Stage}" Style="{StaticResource Text.Caption}" FontSize="11" />
                                            <TextBlock Style="{StaticResource Text.Caption}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}">
                                                <Run Text="{Binding Report.Path, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding Report.Duration.TotalMilliseconds, StringFormat={}{0:N1} ms, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Value -->
                                <Border DockPanel.Dock="Top"
                                        Background="{StaticResource Surface.Input}"
                                        Padding="14,12"
                                        BorderBrush="{StaticResource Border.Subtle}"
                                        BorderThickness="0,1,0,1">
                                    <StackPanel>
                                        <TextBlock Text="VALUE" Style="{StaticResource Text.Label}" />
                                        <TextBlock Text="{Binding Report.Value}"
                                                   Style="{StaticResource Text.Mono}"
                                                   FontSize="14"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Report.ValueKind}"
                                                   Style="{StaticResource Text.Caption}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,4,0,0"
                                                   Visibility="{Binding Report.ValueKind, Converter={StaticResource EmptyToVisibility}}" />
                                        <Button Content="Use this object as expression root"
                                                Style="{StaticResource Button.Chip}"
                                                HorizontalAlignment="Left"
                                                Margin="0,8,0,0"
                                                Command="{Binding PromoteResultToRootCommand}"
                                                ToolTip="Adopt the exact object this field holds as the root of a root-relative expression."
                                                Visibility="{Binding CanPromoteResultToRoot, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource Text.Caption}"
                                                   FontFamily="{StaticResource Font.Mono}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Muted}"
                                                   Margin="0,8,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding Report.Sha256}"
                                                   Visibility="{Binding Report.Sha256, Converter={StaticResource EmptyToVisibility}}">
                                            <Run Text="replay digest " />
                                            <Run Text="{Binding Report.Sha256, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Evidence -->
                                <TabControl Background="Transparent"
                                            BorderThickness="0"
                                            Padding="10"
                                            Foreground="{StaticResource Text.Primary}">
                                    <TabItem Header="Binding facts">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding GroupedReportFacts}"
                                                          Style="{StaticResource Property.List}">
                                                <ItemsControl.GroupStyle>
                                                    <StaticResource ResourceKey="Property.GroupStyle" />
                                                </ItemsControl.GroupStyle>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Raw reads">
                                        <DataGrid Style="{StaticResource Grid.Data}"
                                                  ItemsSource="{Binding ReportMemoryReads}"
                                                  RowHeight="26">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ADDRESS / SOURCE" Binding="{Binding Address}"
                                                                    FontFamily="{StaticResource Font.Mono}" Width="150" />
                                                <DataGridTextColumn Header="REQ" Binding="{Binding Requested}" Width="46" />
                                                <DataGridTextColumn Header="OBS" Binding="{Binding Observed}" Width="46" />
                                                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="76" />
                                                <DataGridTextColumn Header="BYTES" Binding="{Binding Preview}"
                                                                    FontFamily="{StaticResource Font.Mono}" Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="Bounds">
                                        <DataGrid Style="{StaticResource Grid.Data}"
                                                  ItemsSource="{Binding ReportBounds}"
                                                  RowHeight="26">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="BOUND" Binding="{Binding Name}"
                                                                    FontFamily="{StaticResource Font.Mono}" Width="*" />
                                                <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="Auto" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="Diagnostics">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding ReportDiagnostics}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:DiagnosticRow}">
                                                        <StackPanel Margin="0,0,0,12">
                                                            <TextBlock Text="{Binding Code}"
                                                                       Style="{StaticResource Text.Mono}"
                                                                       Foreground="{StaticResource Accent.Partial}" />
                                                            <TextBlock Text="{Binding Message}"
                                                                       Style="{StaticResource Text.Caption}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="SESSION">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Snapshot" Style="{StaticResource Text.Title}" FontSize="14" />
                                <TextBlock Text="Facts read from the immutable dump, plus the deterministic caps this build declares."
                                           Style="{StaticResource Text.Caption}"
                                           FontSize="11"
                                           Margin="0,4,0,10" />
                                <ItemsControl ItemsSource="{Binding Overview.GroupedProperties}"
                                              Style="{StaticResource Property.List}"
                                              Visibility="{Binding Overview.HasProperties, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.GroupStyle>
                                        <StaticResource ResourceKey="Property.GroupStyle" />
                                    </ItemsControl.GroupStyle>
                                </ItemsControl>
                                <TextBlock Text="No dump is open. Use “Open dump…”, drop a dump file onto this window, or pass a path on the command line."
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{StaticResource Text.Muted}"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding Overview.HasProperties, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Separator />
                                <TextBlock Text="What this build can answer" Style="{StaticResource Text.Title}" FontSize="14" />
                                <TextBlock Text="The supported surface is deliberately narrow. Read this before interpreting a result."
                                           Style="{StaticResource Text.Caption}"
                                           FontSize="11"
                                           Margin="0,4,0,12" />
                                <ItemsControl ItemsSource="{Binding Overview.CapabilityNotes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="5" Height="5"
                                                        CornerRadius="3"
                                                        Background="{StaticResource Brand}"
                                                        VerticalAlignment="Top"
                                                        Margin="0,6,10,0" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding}"
                                                           Style="{StaticResource Text.Caption}"
                                                           FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Busy overlay -->
            <Border Grid.ColumnSpan="5"
                    Background="#BB090B10"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="26,20">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Width="240"
                                     Background="{StaticResource Surface.Raised}"
                                     BorderThickness="0"
                                     Foreground="{StaticResource Brand}" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- =========================== Status bar =========================== -->
        <Border Grid.Row="3"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Caption}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1"
                           Style="{StaticResource Text.Caption}"
                           FontSize="11"
                           Margin="0,0,14,0"
                           Foreground="{StaticResource Brand}"
                           ToolTip="{Binding Evaluate.ContextDescription}"
                           Visibility="{Binding Evaluate.HasContextFrame, Converter={StaticResource BoolToVisibility}}"
                           Text="frame context" />
                <TextBlock Grid.Column="2"
                           Text="Read-only · deterministic · budgeted"
                           Style="{StaticResource Text.Caption}"
                           FontSize="11"
                           Foreground="{StaticResource Text.Muted}" />
            </Grid>
        </Border>
    </Grid>
</Window>
