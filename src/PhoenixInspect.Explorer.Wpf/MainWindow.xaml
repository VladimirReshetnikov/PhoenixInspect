<Window x:Class="PhoenixInspect.Explorer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhoenixInspect.Explorer.Wpf.ViewModels"
        xmlns:models="clr-namespace:PhoenixInspect.Explorer.Wpf.Models"
        Title="PhoenixInspect Explorer — internal demo"
        Background="{StaticResource Surface.Base}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        MinWidth="1120"
        MinHeight="720"
        Width="1440"
        Height="900"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <Window.Resources>

        <!-- Call-stack tree -->
        <HierarchicalDataTemplate x:Key="ThreadTemplate"
                                  DataType="{x:Type models:CallStackThreadNode}"
                                  ItemsSource="{Binding Frames}">
            <StackPanel>
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" FontSize="11" />
            </StackPanel>
            <HierarchicalDataTemplate.ItemTemplate>
                <DataTemplate DataType="{x:Type models:CallStackFrameNode}">
                    <StackPanel>
                        <TextBlock Text="{Binding Header}" Style="{StaticResource Text.Mono}" />
                        <TextBlock Text="{Binding Detail}"
                                   Style="{StaticResource Text.Caption}"
                                   FontFamily="{StaticResource Font.Mono}"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}" />
                    </StackPanel>
                </DataTemplate>
            </HierarchicalDataTemplate.ItemTemplate>
        </HierarchicalDataTemplate>

        <!-- Evaluation history entry -->
        <DataTemplate x:Key="HistoryTemplate" DataType="{x:Type models:EvaluationReport}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="6" Height="6"
                        CornerRadius="3"
                        VerticalAlignment="Top"
                        Margin="0,6,9,0"
                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Expression}"
                               Style="{StaticResource Text.Mono}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" TextWrapping="NoWrap">
                        <Run Text="{Binding Status, Mode=OneWay}" />
                        <Run Text="·" Foreground="{StaticResource Text.Muted}" />
                        <Run Text="{Binding Path, Mode=OneWay}" Foreground="{StaticResource Text.Muted}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Expression template chip -->
        <DataTemplate x:Key="SampleTemplate" DataType="{x:Type vm:ExpressionSample}">
            <Button Style="{StaticResource Button.Chip}"
                    Click="OnSampleClick"
                    Margin="0,0,6,6"
                    ToolTip="{Binding Text}"
                    Content="{Binding Label}" />
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Header ============================ -->
        <Border Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34"
                            CornerRadius="9"
                            Background="{StaticResource Brand}"
                            Margin="0,0,12,0">
                        <TextBlock Text="◆"
                                   FontSize="15"
                                   Foreground="#FF16100C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PhoenixInspect Explorer" Style="{StaticResource Text.Title}" FontSize="16" />
                        <TextBlock Text="Internal demo of the implemented dump-inspection surface"
                                   Style="{StaticResource Text.Caption}"
                                   FontSize="11"
                                   Foreground="{StaticResource Text.Muted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Open snapshot summary -->
                <Border Grid.Column="1"
                        Style="{StaticResource Card.Inset}"
                        Padding="14,8"
                        Margin="26,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsDumpOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="DUMP" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DumpFileName}"
                                       Style="{StaticResource Text.Mono}"
                                       ToolTip="{Binding DumpDirectory}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="SNAPSHOT SHA-256" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding SnapshotDigest}" Style="{StaticResource Text.Mono}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="TARGET" Style="{StaticResource Text.Label}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding TargetSummary}" Style="{StaticResource Text.Mono}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Close dump"
                            Style="{StaticResource Button.Ghost}"
                            Command="{Binding CloseDumpCommand}"
                            Margin="0,0,10,0"
                            Visibility="{Binding IsDumpOpen, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Open dump…"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding OpenDumpCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================= Error banner ========================= -->
        <Border Grid.Row="1"
                Background="#33E4574C"
                BorderBrush="{StaticResource Accent.Stopped}"
                BorderThickness="0,0,0,1"
                Padding="20,10"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="！"
                           Foreground="{StaticResource Accent.Stopped}"
                           FontWeight="Bold"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ErrorMessage}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="Dismiss"
                        Style="{StaticResource Button.Chip}"
                        Click="OnDismissErrorClick" />
            </Grid>
        </Border>

        <!-- ============================ Body ============================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Background="{StaticResource Surface.Panel}"
                    BorderBrush="{StaticResource Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="SECTIONS"
                               Style="{StaticResource Text.Label}"
                               Margin="20,18,20,8" />
                    <ListBox ItemsSource="{Binding Sections}"
                             SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}"
                             Style="{StaticResource Nav.List}"
                             ItemContainerStyle="{StaticResource Nav.Item}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationSection}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}"
                                               Foreground="{StaticResource Brand}"
                                               FontSize="14"
                                               Width="22"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding Caption}"
                                                   Style="{StaticResource Text.Caption}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Background="{StaticResource Surface.Raised}"
                                            CornerRadius="9"
                                            Padding="7,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Badge, Converter={StaticResource EmptyToVisibility}}">
                                        <TextBlock Text="{Binding Badge}"
                                                   Style="{StaticResource Text.Mono}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource Text.Secondary}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Section panels -->
            <TabControl Grid.Column="1"
                        Style="{StaticResource Tabs.Chromeless}"
                        SelectedIndex="{Binding SelectedSectionIndex, Mode=TwoWay}">

                <!-- ================= Overview ================= -->
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" MinWidth="420" />
                                <ColumnDefinition Width="2*" MinWidth="300" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Snapshot" Style="{StaticResource Text.Title}" />
                                    <TextBlock Text="Facts read from the immutable dump, plus the deterministic caps this build declares."
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,4,0,10" />
                                    <ItemsControl ItemsSource="{Binding Overview.GroupedProperties}"
                                                  Style="{StaticResource Property.List}"
                                                  Visibility="{Binding Overview.HasProperties, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.GroupStyle>
                                            <StaticResource ResourceKey="Property.GroupStyle" />
                                        </ItemsControl.GroupStyle>
                                    </ItemsControl>
                                    <TextBlock Text="No dump is open. Use “Open dump…”, drop a dump file onto this window, or pass a path on the command line."
                                               Style="{StaticResource Text.Caption}"
                                               Foreground="{StaticResource Text.Muted}"
                                               Margin="0,8,0,0"
                                               Visibility="{Binding Overview.HasProperties, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="What this build can answer" Style="{StaticResource Text.Title}" />
                                    <TextBlock Text="The supported surface is deliberately narrow. Read this before interpreting a result."
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,4,0,12" />
                                    <ItemsControl ItemsSource="{Binding Overview.CapabilityNotes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="5" Height="5"
                                                            CornerRadius="3"
                                                            Background="{StaticResource Brand}"
                                                            VerticalAlignment="Top"
                                                            Margin="0,6,10,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding}"
                                                               Style="{StaticResource Text.Caption}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ================= Modules ================= -->
                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="440" />
                            <ColumnDefinition Width="2*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="Managed modules" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{Binding Modules.Summary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,10" />
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="FILTER BY MODULE NAME OR TARGET PATH HINT" Style="{StaticResource Text.Label}" />
                                <TextBox Style="{StaticResource Input.Text}"
                                         Width="340"
                                         Text="{Binding Modules.Filter, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,12,0">
                            <DataGrid Style="{StaticResource Grid.Data}"
                                      ItemsSource="{Binding Modules.View}"
                                      SelectedItem="{Binding Modules.Selected, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MODULE" Binding="{Binding Name}" Width="*" MinWidth="180" />
                                    <DataGridTextColumn Header="AD" Binding="{Binding AppDomainId}" Width="42" />
                                    <DataGridTextColumn Header="METADATA ROOT" Binding="{Binding MetadataAddress}" Width="184"
                                                        FontFamily="{StaticResource Font.Mono}" />
                                    <DataGridTextColumn Header="SIZE" Binding="{Binding MetadataLength}" Width="82" />
                                    <DataGridTextColumn Header="LAYOUT" Binding="{Binding Layout}" Width="86" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Module content identity" Style="{StaticResource Text.Title}" FontSize="16" />
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Select a module to read its counted metadata from dump memory."
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,12"
                                           Visibility="{Binding Modules.HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Modules.GroupedDetails}"
                                                  Style="{StaticResource Property.List}">
                                                      <ItemsControl.GroupStyle>
                                                          <StaticResource ResourceKey="Property.GroupStyle" />
                                                      </ItemsControl.GroupStyle>
                                                  </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ================= Call stacks ================= -->
                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Managed call stacks" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{Binding CallStacks.Summary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding CallStacks.Note}"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Text.Muted}"
                                       FontSize="11"
                                       Margin="0,4,0,12"
                                       Visibility="{Binding CallStacks.Note, Converter={StaticResource EmptyToVisibility}}" />
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="THREAD ORDINALS TO PROBE" Style="{StaticResource Text.Label}" />
                                    <TextBox Style="{StaticResource Input.Text}" Width="120"
                                             Text="{Binding CallStacks.ThreadOrdinalsToProbe}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="MAX FRAMES PER THREAD" Style="{StaticResource Text.Label}" />
                                    <TextBox Style="{StaticResource Input.Text}" Width="120"
                                             Text="{Binding CallStacks.FramesPerThread}" />
                                </StackPanel>
                                <Button Content="Probe threads"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding CallStacks.ProbeCommand}"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,10,0" />
                                <Button Content="Use frame as name context"
                                        Style="{StaticResource Button.Ghost}"
                                        Command="{Binding CallStacks.UseAsContextCommand}"
                                        VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TreeView x:Name="StacksTree"
                                          Style="{StaticResource Tree.Stacks}"
                                          ItemsSource="{Binding CallStacks.Threads}"
                                          ItemTemplate="{StaticResource ThreadTemplate}"
                                          SelectedItemChanged="OnStackSelectionChanged"
                                          TreeViewItem.Expanded="OnThreadExpanded" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ================= Heap objects ================= -->
                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="440" />
                            <ColumnDefinition Width="2*" MinWidth="290" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="Strong-handle rooted objects" Style="{StaticResource Text.Title}" />
                            <TextBlock Text="{Binding HeapObjects.Summary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,12" />
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="EXACT RUNTIME TYPE NAME (CASE-SENSITIVE)" Style="{StaticResource Text.Label}" />
                                    <TextBox Style="{StaticResource Input.Text}"
                                             FontFamily="{StaticResource Font.Mono}"
                                             Width="420"
                                             Text="{Binding HeapObjects.TypeName, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnObjectSearchKeyDown" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="MATCH CAP" Style="{StaticResource Text.Label}" />
                                    <TextBox Style="{StaticResource Input.Text}" Width="90"
                                             Text="{Binding HeapObjects.MaximumMatches}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="HANDLE CAP" Style="{StaticResource Text.Label}" />
                                    <TextBox Style="{StaticResource Input.Text}" Width="110"
                                             Text="{Binding HeapObjects.MaximumHandlesScanned}" />
                                </StackPanel>
                                <Button Content="Search"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding HeapObjects.SearchCommand}"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,10,0" />
                                <Button Content="Use as expression root"
                                        Style="{StaticResource Button.Ghost}"
                                        Command="{Binding HeapObjects.UseAsRootCommand}"
                                        VerticalAlignment="Bottom" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,12,0">
                          <Grid>
                            <TextBlock Text="No retained matches. Search an exact runtime type name, or promote a static-field object value in Evaluate."
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Text.Muted}"
                                       TextAlignment="Center"
                                       MaxWidth="380"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Panel.ZIndex="1"
                                       Visibility="{Binding HeapObjects.Matches, Converter={StaticResource EmptyToVisibility}, ConverterParameter=invert}" />
                            <DataGrid Style="{StaticResource Grid.Data}"
                                      ItemsSource="{Binding HeapObjects.Matches}"
                                      SelectedItem="{Binding HeapObjects.Selected, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="184"
                                                        FontFamily="{StaticResource Font.Mono}" />
                                    <DataGridTextColumn Header="RUNTIME TYPE" Binding="{Binding TypeName}" Width="2*" MinWidth="160" />
                                    <DataGridTextColumn Header="HANDLE" Binding="{Binding RootKind}" Width="112" />
                                    <DataGridTextColumn Header="MODULE" Binding="{Binding ModuleName}" Width="*" MinWidth="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                          </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Traversal evidence" Style="{StaticResource Text.Title}" FontSize="16" />
                                <TextBlock DockPanel.Dock="Top"
                                           Text="A truncated traversal is never presented as exhaustive."
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,12" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding HeapObjects.GroupedSearchFacts}"
                                                  Style="{StaticResource Property.List}">
                                                      <ItemsControl.GroupStyle>
                                                          <StaticResource ResourceKey="Property.GroupStyle" />
                                                      </ItemsControl.GroupStyle>
                                                  </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ================= Evaluate ================= -->
                <TabItem>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="520" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Request -->
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14" Grid.ColumnSpan="2">
                            <StackPanel>
                                <TextBlock Text="Evaluate an expression" Style="{StaticResource Text.Title}" />
                                <TextBlock Text="{Binding Evaluate.ReadinessMessage}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,4,0,14" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton GroupName="Path"
                                                 Margin="0,0,10,0"
                                                 IsChecked="{Binding Evaluate.IsStaticFieldPath, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Static field" FontWeight="SemiBold" />
                                            <TextBlock Text="Namespace-qualified static field, bound from module metadata"
                                                       Style="{StaticResource Text.Caption}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton GroupName="Path"
                                                 IsChecked="{Binding Evaluate.IsRootRelativePath, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="Root-relative" FontWeight="SemiBold" />
                                            <TextBlock Text="Member expression over one exact heap object"
                                                       Style="{StaticResource Text.Caption}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExpressionBox"
                                             Style="{StaticResource Input.Expression}"
                                             Text="{Binding Evaluate.Expression, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnExpressionKeyDown" />
                                    <Button Grid.Column="1"
                                            Content="Evaluate"
                                            Style="{StaticResource Button.Primary}"
                                            Command="{Binding Evaluate.EvaluateCommand}"
                                            Margin="10,0,0,0"
                                            Padding="20,7" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Evaluate.Samples}"
                                              ItemTemplate="{StaticResource SampleTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- Static-field options -->
                                <Border Style="{StaticResource Card.Inset}"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding Evaluate.IsStaticFieldPath, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="NAME CONTEXT" Style="{StaticResource Text.Label}" />
                                            <TextBlock Text="{Binding Evaluate.ContextDescription}"
                                                       Style="{StaticResource Text.Caption}" />
                                            <Button Content="Drop adopted frame"
                                                    Style="{StaticResource Button.Chip}"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,8,0,0"
                                                    Command="{Binding Evaluate.ClearContextCommand}"
                                                    Visibility="{Binding Evaluate.HasContextFrame, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="PORTABLE-PDB CANDIDATES (ONE PATH PER LINE)" Style="{StaticResource Text.Label}" />
                                            <TextBox Style="{StaticResource Input.Text}"
                                                     FontFamily="{StaticResource Font.Mono}"
                                                     FontSize="11"
                                                     Height="62"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Text="{Binding Evaluate.PortablePdbCandidates, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Root-relative options -->
                                <Border Style="{StaticResource Card.Inset}"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding Evaluate.IsRootRelativePath, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,18,0">
                                                <TextBlock Text="ROOT IDENTIFIER" Style="{StaticResource Text.Label}" />
                                                <TextBox Style="{StaticResource Input.Text}"
                                                         FontFamily="{StaticResource Font.Mono}"
                                                         Width="150"
                                                         Text="{Binding Evaluate.RootIdentifier, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ADOPTED ROOT" Style="{StaticResource Text.Label}" />
                                                <TextBlock Text="{Binding Evaluate.RootDescription}"
                                                           Style="{StaticResource Text.Caption}"
                                                           FontFamily="{StaticResource Font.Mono}"
                                                           FontSize="11" />
                                                <Button Content="Drop adopted root"
                                                        Style="{StaticResource Button.Chip}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,8,0,0"
                                                        Command="{Binding Evaluate.ClearRootCommand}"
                                                        Visibility="{Binding Evaluate.HasRootObject, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                        <Separator />
                                        <WrapPanel>
                                            <CheckBox Content="Admit two-hop member chains"
                                                      Margin="0,0,22,8"
                                                      IsChecked="{Binding Evaluate.AdmitMemberChain, Mode=TwoWay}" />
                                            <CheckBox Content="Replace admitted helpers with pure models"
                                                      Margin="0,0,22,8"
                                                      IsChecked="{Binding Evaluate.UseModeledMethods, Mode=TwoWay}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                                <TextBlock Text="Instruction budget"
                                                           Style="{StaticResource Text.Caption}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBox Style="{StaticResource Input.Text}"
                                                         Width="100"
                                                         Padding="8,4"
                                                         Text="{Binding Evaluate.InstructionLimit}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,18,8">
                                                <TextBlock Text="Call depth"
                                                           Style="{StaticResource Text.Caption}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBox Style="{StaticResource Input.Text}"
                                                         Width="70"
                                                         Padding="8,4"
                                                         Text="{Binding Evaluate.LogicalDepthLimit}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Traversal units"
                                                           Style="{StaticResource Text.Caption}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0" />
                                                <TextBox Style="{StaticResource Input.Text}"
                                                         Width="90"
                                                         Padding="8,4"
                                                         Text="{Binding Evaluate.TraversalLimit}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Evaluate.LimitsCaption}"
                                                   Style="{StaticResource Text.Caption}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource Text.Muted}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Result -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <TextBlock Text="No expression has been evaluated yet."
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Evaluate.HasReport, Converter={StaticResource InverseBoolToVisibility}}" />

                                <DockPanel Visibility="{Binding Evaluate.HasReport, Converter={StaticResource BoolToVisibility}}"
                                           DataContext="{Binding Evaluate}">
                                    <!-- Outcome banner -->
                                    <Border DockPanel.Dock="Top"
                                            Background="{StaticResource Surface.Raised}"
                                            CornerRadius="8,8,0,0"
                                            Padding="18,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40"
                                                    CornerRadius="20"
                                                    Margin="0,0,14,0"
                                                    Background="{Binding Report.Severity, Converter={StaticResource SeverityToBrush}}">
                                                <TextBlock Text="{Binding Report.Severity, Converter={StaticResource SeverityToGlyph}}"
                                                           FontSize="17"
                                                           Foreground="#FF10121A"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Text.Title}" FontSize="16">
                                                    <Run Text="{Binding Report.Status, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding Report.Stage}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Button Content="Use this object as expression root"
                                                        Style="{StaticResource Button.Chip}"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,0,6"
                                                        Command="{Binding PromoteResultToRootCommand}"
                                                        ToolTip="Adopt the exact object this field holds as the root of a root-relative expression."
                                                        Visibility="{Binding CanPromoteResultToRoot, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Report.Path}"
                                                           Style="{StaticResource Text.Caption}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Style="{StaticResource Text.Caption}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Text.Muted}"
                                                           HorizontalAlignment="Right">
                                                    <Run Text="{Binding Report.Duration.TotalMilliseconds, StringFormat={}{0:N1} ms, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Value -->
                                    <Border DockPanel.Dock="Top"
                                            Background="{StaticResource Surface.Input}"
                                            Padding="18,14"
                                            BorderBrush="{StaticResource Border.Subtle}"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="VALUE" Style="{StaticResource Text.Label}" />
                                            <TextBlock Text="{Binding Report.Value}"
                                                       Style="{StaticResource Text.Mono}"
                                                       FontSize="16"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Report.ValueKind}"
                                                       Style="{StaticResource Text.Caption}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Text.Muted}"
                                                       Margin="0,4,0,0"
                                                       Visibility="{Binding Report.ValueKind, Converter={StaticResource EmptyToVisibility}}" />
                                            <TextBlock Style="{StaticResource Text.Caption}"
                                                       FontFamily="{StaticResource Font.Mono}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource Text.Muted}"
                                                       Margin="0,8,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Visibility="{Binding Report.Sha256, Converter={StaticResource EmptyToVisibility}}">
                                                <Run Text="canonical replay digest " />
                                                <Run Text="{Binding Report.Sha256, Mode=OneWay}" Foreground="{StaticResource Text.Secondary}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Evidence -->
                                    <TabControl Background="Transparent"
                                                BorderThickness="0"
                                                Padding="14"
                                                Foreground="{StaticResource Text.Primary}">
                                        <TabItem Header="Binding facts">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding GroupedReportFacts}"
                                                              Style="{StaticResource Property.List}">
                                                                  <ItemsControl.GroupStyle>
                                                                      <StaticResource ResourceKey="Property.GroupStyle" />
                                                                  </ItemsControl.GroupStyle>
                                                              </ItemsControl>
                                            </ScrollViewer>
                                        </TabItem>
                                        <TabItem Header="Raw reads">
                                            <DataGrid Style="{StaticResource Grid.Data}"
                                                      ItemsSource="{Binding ReportMemoryReads}"
                                                      RowHeight="26">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ADDRESS / SOURCE" Binding="{Binding Address}"
                                                                        FontFamily="{StaticResource Font.Mono}" Width="184" />
                                                    <DataGridTextColumn Header="REQUESTED" Binding="{Binding Requested}" Width="88" />
                                                    <DataGridTextColumn Header="OBSERVED" Binding="{Binding Observed}" Width="84" />
                                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
                                                    <DataGridTextColumn Header="BYTES" Binding="{Binding Preview}"
                                                                        FontFamily="{StaticResource Font.Mono}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="Applied bounds">
                                            <DataGrid Style="{StaticResource Grid.Data}"
                                                      ItemsSource="{Binding ReportBounds}"
                                                      RowHeight="26">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="BOUND" Binding="{Binding Name}"
                                                                        FontFamily="{StaticResource Font.Mono}" Width="*" />
                                                    <DataGridTextColumn Header="VALUE" Binding="{Binding Value}" Width="Auto" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                        <TabItem Header="Diagnostics">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding ReportDiagnostics}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:DiagnosticRow}">
                                                            <StackPanel Margin="0,0,0,12">
                                                                <TextBlock Text="{Binding Code}"
                                                                           Style="{StaticResource Text.Mono}"
                                                                           Foreground="{StaticResource Accent.Partial}" />
                                                                <TextBlock Text="{Binding Message}"
                                                                           Style="{StaticResource Text.Caption}"
                                                                           Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </TabItem>
                                    </TabControl>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- History -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Width="300" Margin="14,0,0,0">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="History" Style="{StaticResource Text.Title}" FontSize="16" />
                                    <Button Grid.Column="1"
                                            Content="Clear"
                                            Style="{StaticResource Button.Chip}"
                                            Command="{Binding Evaluate.ClearHistoryCommand}" />
                                </Grid>
                                <ListBox ItemsSource="{Binding Evaluate.History}"
                                         SelectedItem="{Binding Evaluate.Report, Mode=TwoWay}"
                                         Style="{StaticResource List.Plain}"
                                         ItemContainerStyle="{StaticResource List.Item}"
                                         ItemTemplate="{StaticResource HistoryTemplate}" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Busy overlay -->
            <Border Grid.ColumnSpan="2"
                    Background="#BB090B10"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="26,20">
                    <StackPanel>
                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     Width="240"
                                     Background="{StaticResource Surface.Raised}"
                                     BorderThickness="0"
                                     Foreground="{StaticResource Brand}" />
                        <TextBlock Text="{Binding BusyMessage}"
                                   Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- =========================== Status bar =========================== -->
        <Border Grid.Row="3"
                Background="{StaticResource Surface.Panel}"
                BorderBrush="{StaticResource Border.Subtle}"
                BorderThickness="0,1,0,0"
                Padding="20,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource Text.Caption}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1"
                           Text="Read-only · deterministic · budgeted"
                           Style="{StaticResource Text.Caption}"
                           FontSize="11"
                           Foreground="{StaticResource Text.Muted}" />
            </Grid>
        </Border>
    </Grid>
</Window>
