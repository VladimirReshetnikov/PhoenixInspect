<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Internal demonstration host. This project exists to exercise the currently implemented dump-inspection and
    expression-evaluation surface interactively; it is not a shipped product and deliberately adds no new analysis
    capability of its own. Every fact it renders comes from an existing public contract.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhoenixInspect.Explorer.Wpf</RootNamespace>
    <AssemblyName>PhoenixInspect.Explorer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhoenixInspect.Core.Abstractions\PhoenixInspect.Core.Abstractions.csproj" />
    <ProjectReference Include="..\PhoenixInspect.Host.Abstractions\PhoenixInspect.Host.Abstractions.csproj" />
    <ProjectReference Include="..\PhoenixInspect.Host.Dump.ClrMD\PhoenixInspect.Host.Dump.ClrMD.csproj" />
    <ProjectReference Include="..\PhoenixInspect.Product.DumpDebugging\PhoenixInspect.Product.DumpDebugging.csproj" />
    <ProjectReference Include="..\PhoenixInspect.Product.DumpQuery\PhoenixInspect.Product.DumpQuery.csproj" />
  </ItemGroup>

</Project>
