<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>PhoenixInspect.W8WorkflowShapeTarget</AssemblyName>
    <RootNamespace>PhoenixInspect.W8WorkflowShapeTarget</RootNamespace>
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PhoenixInspect.W8AliasTarget/PhoenixInspect.W8AliasTarget.csproj">
      <Aliases>global,wflib</Aliases>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../TestInfrastructure/HeadlessTestProcess.cs"
             Link="TestInfrastructure/HeadlessTestProcess.cs" />
  </ItemGroup>
</Project>
