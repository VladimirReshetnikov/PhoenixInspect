<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Interpreter.Host.ExternalWorker.Tests</AssemblyName>
    <RootNamespace>Interpreter.Host.ExternalWorker.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Interpreter.Host.ExternalWorker/Interpreter.Host.ExternalWorker.csproj" />
    <ProjectReference Include="../../src/Interpreter.Host.ExternalWorker.Runner/Interpreter.Host.ExternalWorker.Runner.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup>
    <ExternalWorkerRunnerOutput>$(MSBuildProjectDirectory)\..\..\src\Interpreter.Host.ExternalWorker.Runner\bin\$(Configuration)\net10.0-windows</ExternalWorkerRunnerOutput>
  </PropertyGroup>

  <Target Name="CopyExternalWorkerRunnerForTests" AfterTargets="Build">
    <PropertyGroup>
      <_ExternalWorkerRunnerTestOutput>$(TargetDir)external-worker-runner</_ExternalWorkerRunnerTestOutput>
    </PropertyGroup>
    <ItemGroup>
      <_ExternalWorkerRunnerFile Include="$(ExternalWorkerRunnerOutput)\*"
                                 Exclude="$(ExternalWorkerRunnerOutput)\*.pdb;$(ExternalWorkerRunnerOutput)\*.xml" />
    </ItemGroup>
    <Error Condition="!Exists('$(ExternalWorkerRunnerOutput)\Interpreter.Host.ExternalWorker.Runner.exe')"
           Text="The external-worker runner apphost was not built." />
    <MakeDir Directories="$(_ExternalWorkerRunnerTestOutput)" />
    <Copy SourceFiles="@(_ExternalWorkerRunnerFile)"
          DestinationFolder="$(_ExternalWorkerRunnerTestOutput)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
