<Project>
  <ItemGroup Condition="'$(IsTestProject)' == 'true' Or '$(MSBuildProjectName)' == 'PhoenixInspect.TestTarget'">
    <Compile Include="$(MSBuildThisFileDirectory)TestInfrastructure\HeadlessTestProcess.cs"
             Link="TestInfrastructure\HeadlessTestProcess.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)TestInfrastructure\HeadlessTestFramework.cs"
             Link="TestInfrastructure\HeadlessTestFramework.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TestInfrastructure\HeadlessTestProcessTests.cs"
             Link="TestInfrastructure\HeadlessTestProcessTests.cs" />
    <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
      <_Parameter1>PhoenixInspect.Tests.Infrastructure.HeadlessTestFramework</_Parameter1>
      <_Parameter2>$(AssemblyName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
